# Upstash Redis REST API Credentials (required in production).
# Without these the server falls back to an in-memory store that is shared
# process-wide -- acceptable for local development only.
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# VAPID Web Push Keys.
# REQUIRED in production: if omitted, an ephemeral key pair is generated per
# process, so existing push subscriptions stop working after a restart.
# Generate a stable pair once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT="mailto:admin@example.com"
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
